# Скопируйте: cp .env.example .env && отредактируйте значения.
# Секреты не коммитьте.

# ---- PostgreSQL (только внутри compose, порты наружу не открываются) ----
# POSTGRES_PASSWORD задаётся ТОЛЬКО при пустом томе pg_data; смена в .env не обновит пароль в БД.
# Если pgAdmin пишет password authentication failed: из контейнера postgres
#   psql -U $POSTGRES_USER -d postgres -c "ALTER USER $POSTGRES_USER WITH PASSWORD 'актуальный_из_.env';"
POSTGRES_USER=autello
POSTGRES_PASSWORD=смените_на_сильный_пароль
POSTGRES_DB=autello

# ---- Backend (только внутри сети Docker; снаружи — Nginx :80 → /api/) ----
# Порта 8000 наружу нет. Документация API в браузере с :80 отключена в Nginx (404); OpenAPI на бэке: ENABLE_OPENAPI=true
# и тогда: docker compose exec backend curl -sS localhost:8000/docs
# Секрет подписи JWT (админ-вход). Обязательно смените в production.
# ENABLE_OPENAPI=false
# JWT_SECRET=длинная_случайная_строка

# ---- Frontend: в каталоге frontend/ выполните npm install && npm run build (артефакт в frontend/dist для Nginx :80) ----

# ---- pgAdmin (по умолчанию ВЫКЛ; включение: docker compose --profile tools up -d) ----
# http://<IP_СЕРВЕРА>:5050/ — логин/пароль ТОЛЬКО при первом создании тома pgadmin_data.
# Только http (не https). Порт по умолчанию доступен с сети; закрыть в мир, оставить localhost: PGADMIN_BIND_ADDRESS=127.0.0.1
# В firewall откройте TCP 5050, пароль в AUTELLO_PGADMIN_PASSWORD задайте длинный.
# PGADMIN_BIND_ADDRESS=127.0.0.1
# Переменные AUTELLO_PGADMIN_* (не PGADMIN_DEFAULT_*): иначе Cursor/IDE подставляет в shell свои PGADMIN_DEFAULT_*
# и docker compose игнорирует почту из .env — в итоге учётка admin@example.com, а вы вводите почту из файла.
# Сброс тома: docker compose stop pgadmin pgadmin-nginx && docker volume rm … && docker compose --profile tools up -d pgadmin pgadmin-nginx
AUTELLO_PGADMIN_EMAIL=admin@example.com
AUTELLO_PGADMIN_PASSWORD=смените_на_сильный_пароль

# ---------------------------------------------------------------------------
# Docker Registry (по умолчанию ВЫКЛ; включение: docker compose --profile tools up -d)
# Авторизация: htpasswd (Basic Auth).
# Учётки задаются только в registry-auth/htpasswd; переменные ниже — для заметок и скриптов.
#
# Создать/обновить htpasswd (логин и пароль для docker login):
#   docker run --rm --entrypoint htpasswd httpd:2.4 -Bbn ВАШ_ЛОГИН 'ВАШ_ПАРОЛЬ' > registry-auth/htpasswd
#   docker compose restart registry
#
# HTTP без TLS: на клиенте (машина, откуда делается push/pull) в /etc/docker/daemon.json:
#   { "insecure-registries": ["<IP_ИЛИ_ДНС>:5000"] }
#   sudo systemctl restart docker   (или перезапуск Docker Desktop)
# Для production — TLS и registry за HTTPS (тогда insecure-registries не нужен).
#
# Интерактивный docker login (подставьте хост: порт, на сервере — 127.0.0.1:5000):
#   docker login 127.0.0.1:5000
# Введите User / Password, совпадающие с htpasswd. Realm в браузере/клиенте: «Autello Docker Registry».
#
# Неинтерактивно (после раскомментирования и заполнения):
#   set -a && source .env && set +a
#   echo "$REGISTRY_PASSWORD" | docker login "$REGISTRY_HOST" -u "$REGISTRY_USER" --password-stdin
# ---------------------------------------------------------------------------
# REGISTRY_HOST=127.0.0.1:5000
# REGISTRY_USER=registry_user
# REGISTRY_PASSWORD=...   # тот же пароль, что в htpasswd; registry сам .env не читает
